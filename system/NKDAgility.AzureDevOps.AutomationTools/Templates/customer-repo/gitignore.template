# Generated output, logs and checkpoints - never commit
/output/
*.checkpoint.json

# Run logs are committed engagement history (Start-AutomationRunLog). Only the
# repo-level /output/ above is ignored; never ignore an engagement's output/runs/.
!/migrations/*/output/runs/

# Secrets - never commit
/secrets/*
!/secrets/secrets.example.json

# Machine-specific overrides
workspace.local.json

# Materialised engine copies - generated by init.ps1, never edited, never committed
/.system/
